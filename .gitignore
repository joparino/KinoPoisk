# IDE and local configuration
.idea/
*.iml
*.ipr
*.iws
local.properties

# Gradle, Kotlin and generated build output
.kotlin/
.gradle/
**/build/
!src/**/build/
captures/
.externalNativeBuild/
.cxx/

# Local signing and service configuration
keystore.properties
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Local logs and JVM diagnostics
*.log
hs_err_pid*
replay_pid*
*.hprof

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Xcode user state (for future iOS support)
xcuserdata/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# JavaScript dependencies (for future web support)
node_modules/
